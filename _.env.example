# Main (manager) bot token from BotFather
MAIN_BOT_TOKEN=

# Tumhara Telegram numeric user ID (sirf tum main bot chala sakoge)
OWNER_ID=

# MongoDB Atlas connection string
MONGO_URI=
DB_NAME=filebot

# Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# Render service ka public URL, e.g. https://myfilebot.onrender.com (no trailing slash)
BASE_URL=

# Koi bhi lamba random string
WEBHOOK_SECRET=

# Private channels ke IDs (-100 se shuru)
PRIMARY_CHANNEL=
BACKUP_CHANNEL=

# Health check interval seconds (default 300)
HEALTH_INTERVAL=300

# Koyeb: Dockerfile builder, port 8000 (KOYEB.md dekho)
# Render start command:
# uvicorn main:app --host 0.0.0.0 --port $PORT

# ---------------- Auto Posting (Control Center -> 🤖 Auto Posting) ----------------
# Sab OPTIONAL. Token / Mongo / owner HelpBot wale hi use hote hain (MAIN_BOT_TOKEN, MONGO_URI, OWNER_ID).
# Data alag Mongo database me jata hai: <DB_NAME>_autoposter  (badalna ho to AP_DB_NAME)
# AP_DB_NAME=
# Schedule / logs ka timezone (default Asia/Kolkata)
# TIMEZONE=Asia/Kolkata
# Destructive actions (wipe/remove) ke liye password; khali = password nahi
# ADMIN_PASSWORD=
# Source channel se import kiye posts ki safe copy yahan rakhi jati hai (bot is channel me admin ho)
# VAULT_CHAT_ID=
# Owner ke alawa aur admins (comma separated numeric IDs)
# AP_EXTRA_ADMIN_IDS=
# Naye target ke defaults
# DEFAULT_INTERVAL_MINUTES=180
# DEFAULT_BATCH_SIZE=5
# DEFAULT_START_TIME=00:00
# DEFAULT_END_TIME=21:00
# DEFAULT_DAYS=0,1,2,3,4,5,6
# SCAN_INTERVAL_SECONDS=30
# RETRY_ATTEMPTS=3
# POST_GAP_SECONDS=1
# LOG_RETENTION_DAYS=14

# ======================= Smart Ads (Monetag + AdsGram + Tads.me rotation) =======================
# Everything below is OPTIONAL. SMART_ADS_ENABLED unset/false = your original Monetag-only flow, unchanged.
# SMART_ADS_ENABLED=true
# Admin dashboard (/admin/ads) + admin JSON API token. Long random string. Empty = admin API/dashboard disabled.
# (falls back to MONETAG_ADMIN_TOKEN if that is set)
# ADS_ADMIN_TOKEN=
# --- AdsGram (partner.adsgram.ai): create Ad platform + a *Reward* ad unit, copy BlockID ---
# ADSGRAM_BLOCK_ID=
# Secret you invent; put it in the AdsGram unit's Reward URL (see README). Empty = no server verification for AdsGram.
# ADSGRAM_REWARD_SECRET=
# ADSGRAM_DEBUG=false      # true = test ads, no Reward URL call, no stats. Never in production.
# --- Tads.me (tads.me -> Publisher -> Widgets): create a *fullscreen* widget, copy its ID ---
# TADS_WIDGET_ID=
# TADS_DEBUG=false
# Tads documents only browser callbacks (no postback). false = Tads is never used for rewards until you opt in.
# TADS_ALLOW_CLIENT_REWARD=false
# --- tuning (defaults shown) ---
# ADS_OPT_INTERVAL=300            # seconds between optimizer rounds
# ADS_UNSHOWN_LOCK_SECONDS=25     # an attempt that never displayed frees the user's slot after this
# ADS_SHOWN_LOCK_SECONDS=180
# ADSGRAM_SDK_URL=https://sad.adsgram.ai/js/sad.min.js
# TADS_SDK_URL=https://w.tads.me/widget.js
# Existing Monetag vars (MONETAG_ZONE_ID, MONETAG_ZONES, AD_VERIFY_MODE, MONETAG_POSTBACK_SECRET, ...) keep working as before.
